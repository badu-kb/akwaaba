# Copy to .env and fill in. Never share this file.

# From platform.claude.com > Settings > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# From the Meta App Dashboard > WhatsApp > API Setup
META_ACCESS_TOKEN=paste-access-token-here
META_PHONE_NUMBER_ID=paste-phone-number-id-here

# Make up any password-like word. Type the SAME word into the
# "Verify token" box in Meta's webhook settings.
META_VERIFY_TOKEN=akwaaba-make-up-a-word

# From the Meta App Dashboard > App settings > Basic > App secret (click Show).
# Lets the app reject requests that didn't come from Meta.
META_APP_SECRET=

# Your WhatsApp Business Account ID (Meta App Dashboard > WhatsApp > API Setup,
# shown as "WhatsApp Business Account ID" or "Messaging account ID"). Needed for native forms.
META_WABA_ID=

# Native forms created in WhatsApp Manager (Account tools > Flows). Paste each form's ID.
# Leave blank to use buttons instead. FLOWS_STATUS: PUBLISHED, or DRAFT while testing.
FLOW_ONBOARDING_ID=
FLOW_LESSON_ID=
FLOW_DANGER_ID=
FLOWS_STATUS=PUBLISHED

# Voice notes: free key from https://translation.ghananlp.org (GhanaNLP Khaya).
# Also needs ffmpeg:  brew install ffmpeg
KHAYA_API_KEY=
# Voice for spoken replies: female, male_low or male_high. Try them with: python voice_samples.py
TTS_VOICE_EN=female
TTS_VOICE_TW=female
TTS_VOICE_EE=female
# Set to off if no English voice sounds right; Twi and Ewe voice replies still work.
ENGLISH_VOICE=on

# Optional
CLAUDE_MODEL=claude-sonnet-5-5
# Smaller model used in the background to update long-term memory
MEMORY_MODEL=claude-haiku-5-5
# How many recent messages are kept word for word before older ones are summarised
RECENT_MESSAGES=24
# Your WhatsApp number in digits (used for the Share link and QR code; found automatically if blank)
WHATSAPP_DISPLAY_NUMBER=
MAX_TOKENS=3000
USAGE_LOG=usage_log.jsonl
META_GRAPH_VERSION=v23.0

# Your free fixed ngrok address (no https://). When set, start.sh starts ngrok for you.
NGROK_DOMAIN=
# Optional: protect the /dashboard page, then open it as /dashboard?key=YOURKEY
DASHBOARD_KEY=            # optional; if empty, one is made for you and the full dashboard link is shown at start-up
# LOG_SALT=               # optional secret for the one-way phone codes in the usage log; made for you if empty
# Register photos stay OFF until the district and Ghana's Data Protection Commission approve them:
# REGISTER_PHOTOS=on
# Optional: max messages per person per hour
RATE_LIMIT_PER_HOUR=40
# Optional: who people contact about their data (shown on the privacy page)
PRIVACY_CONTACT=

# Voice notes: which service speaks each language. English defaults to Abena AI (Ghanaian accent);
# Twi and Ewe default to Khaya. Compare them with: python voice_samples.py
# TTS_PROVIDER_EN=abena
# TTS_PROVIDER_TW=khaya
# TTS_PROVIDER_EE=khaya
# ABENA_API_KEY=            # optional; a free account at abena.mobobi.com lifts the free-tier limits
# ABENA_VOICE_EN=akua_eng_high     # or kwabena_eng_high, akua_eng_medium, kwabena_eng_medium
# ABENA_VOICE_TW=abena_twi_high    # or kofi_twi_high
# ABENA_VOICE_EE=mawuli_ewe
# ABENA_SPEED=1.0

# Draft Twi and Ewe danger phrases (safety_local.json). Off = shadow mode: matches are counted in
# the usage log but no card is sent. Turn on only after native-speaking clinicians have reviewed them.
# SAFETY_LOCAL=off

# SMS fallback for weak mobile data (Africa's Talking). Off unless all four are set.
# The callback address to give Africa's Talking is: https://<your-domain>/sms/inbound/<SMS_INBOUND_KEY>
# SMS_PROVIDER=africastalking
# AT_USERNAME=
# AT_API_KEY=
# SMS_INBOUND_KEY=          # a long random string, at least 24 characters
# AT_SENDER_ID=             # optional short code or sender name
